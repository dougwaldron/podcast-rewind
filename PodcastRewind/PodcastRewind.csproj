<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
      <Version>10.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />
    <PackageReference Include="Luandersonn.iTunesPodcastFinder" Version="2.2.2" />
      <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.10" />
      <PackageReference Include="Microsoft.Web.LibraryManager.Build" Version="3.0.114" />
      <PackageReference Include="Sentry.AspNetCore" Version="6.7.0" />
      <PackageReference Include="SonarAnalyzer.CSharp" Version="10.30.0.144632">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
      <PackageReference Include="System.ServiceModel.Syndication" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <DependentUpon>appsettings.json</DependentUpon>
    </Content>
  </ItemGroup>

</Project>
